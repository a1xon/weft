{
  "manifest_version": 3,
  "name": "weft marks",
  "version": "1.0",
  "description": "Mark something on a web page and say what is wrong: a weft agent gets it with the page, the element, its component and a screenshot.",
  "key": "",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "Mark something for weft (Alt+Shift+W)",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+W" }, "description": "Mark something on the page for weft" }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "scripting", "nativeMessaging", "storage"],
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "https://localhost/*", "http://127.0.0.1/*", "http://0.0.0.0/*", "http://*.localhost/*", "https://*.localhost/*"],
      "js": ["probe.js"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ]
}
